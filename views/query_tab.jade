.editing
  textarea.editor
.middlebar
  .resizer
  button.native-look(exec="runQuery" title="Cmd+R") Run Query
  button.native-look(exec="showHistory") See History
  button.native-look(exec="openSnippets") Snippets
  button.native-look(exec="saveSnippet" title="Cmd+S") Save Snippet
  button.native-look.is-hidden.cleanButton(exec="cleanButtonClick" title="Clear results bellow") Clear
  span.save-split.is-hidden
    button.native-look.saveButton(exec="saveQueryResult" title="Save Result to file") Save as CSV
    button.native-look.saveMenuButton(exec="toggleSaveMenu()" title="Choose file format") ▾
    .save-menu.is-hidden
      each format in exportFormats
        a.save-format(exec="selectSaveFormat('" + format.id + "')" data-format=format.id)= format.label
      .save-menu-footer
        a.save-settings(exec="openExportSettings" title="Export settings (module / CommonJS, SQL)") ⚙&#xFE0E;
.result
  .rescol-wrapper
    .rescol-header-wrapper
    .rescol-content-wrapper
      table
  .status