form
  p.export-settings-hint Module style for "Save as TypeScript" and "Save as JavaScript"

  p.module-system-toggle
    label
      input(type="radio" name="module_system" value="module" checked=(moduleSystem == 'module'))
      = " Module"
      code export const result = [...]
    label
      input(type="radio" name="module_system" value="commonjs" checked=(moduleSystem == 'commonjs'))
      = " CommonJS"
      code module.exports = { result }
      span.ts-note (TypeScript: export = result)

  p.export-settings-hint "Save as SQL"

  p.module-system-toggle.sql-options
    label
      input(type="checkbox" name="sql_create_table" checked=sqlCreateTable)
      = " Include CREATE TABLE"
      code before the INSERT statements

  p.buttons
    button.ok Done
